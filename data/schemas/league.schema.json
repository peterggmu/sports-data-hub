{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterggmu/sports-data-hub/blob/main/data/schemas/league.schema.json",
  "title": "League",
  "type": "object",
  "required": ["id", "name_zh", "name_en", "country", "sport", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "sport": {"type": "string", "enum": ["football", "basketball"]},
    "country": {"type": "string", "minLength": 1},
    "confederation": {"type": "string", "enum": ["AFC", "CAF", "CONCACAF", "CONMEBOL", "OFC", "UEFA", "FIBA"]},
    "level": {"type": "string"},
    "founded": {"type": ["integer", "null"], "minimum": 1800},
    "updated_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
