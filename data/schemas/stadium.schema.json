{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterggmu/sports-data-hub/blob/main/data/schemas/stadium.schema.json",
  "title": "Stadium",
  "type": "object",
  "required": ["id", "name_zh", "name_en", "city", "country", "capacity", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "city": {"type": "string", "minLength": 1},
    "country": {"type": "string", "minLength": 1},
    "capacity": {"type": "integer", "minimum": 0, "description": "场馆容量，单位：人"},
    "opened": {"type": ["integer", "null"], "minimum": 1800},
    "surface": {"type": ["string", "null"], "enum": ["grass", "hybrid", "artificial", "hardwood", null]},
    "photo_path": {"type": ["string", "null"]},
    "coordinates": {
      "type": ["object", "null"],
      "required": ["lat", "lng"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180}
      },
      "additionalProperties": false
    },
    "tenant_ids": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "uniqueItems": true
    },
    "updated_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
