{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterggmu/sports-data-hub/blob/main/data/schemas/team.schema.json",
  "title": "Team",
  "type": "object",
  "required": ["id", "name_zh", "name_en", "sport", "league_id", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name_zh": {"type": "string", "minLength": 1},
    "name_en": {"type": "string", "minLength": 1},
    "sport": {"type": "string", "enum": ["football", "basketball"]},
    "league_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "stadium_id": {"type": ["string", "null"], "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "city": {"type": "string"},
    "country": {"type": "string"},
    "founded": {"type": ["integer", "null"], "minimum": 1800},
    "crest_path": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
